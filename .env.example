# Copy to .env and adjust. Every value has a development default, so .env is optional locally.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. `make db-start` runs a local server on port 5433 that matches this URL.
DATABASE_URL=postgres://ridepulse:ridepulse@127.0.0.1:5433/ridepulse

# Redis (optional). Without it, background tasks run inline and WebSocket events from other
# processes (the simulator, workers) travel through PostgreSQL LISTEN/NOTIFY instead.
# REALTIME_RELAY=postgres|layer overrides that choice.
REDIS_URL=
CELERY_BROKER_URL=
# REDIS_URL=redis://localhost:6379/1
# CELERY_BROKER_URL=redis://localhost:6379/0

# Dispatch strategy: SEQUENTIAL (offer to the best driver, then the next) or BATCHED
# (Hungarian-algorithm assignment of all open requests each sweep).
DISPATCH_MODE=SEQUENTIAL

# --- Google Maps Platform (optional) ----------------------------------------------------------
# Server key: Routes API (real road distance, traffic-aware ETAs, route polylines).
#   Restrict it to the Routes API and your server's IP address.
GOOGLE_MAPS_API_KEY=
# Browser key: Maps JavaScript API + Places API (New) + Geocoding in the React apps.
#   Restrict it to those APIs and to your site's HTTP referrers (e.g. http://localhost:8000/*).
GOOGLE_MAPS_BROWSER_KEY=
# A map ID from the Google Cloud console (DEMO_MAP_ID works for development).
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# true = traffic-aware routes (billed as Routes "Pro"); false = cheaper "Essentials" routes.
GOOGLE_ROUTES_TRAFFIC_AWARE=true

CORS_ALLOWED_ORIGINS=http://localhost:5173
# Emails print in the server terminal by default. To really send them (e.g. Gmail with an
# app password from myaccount.google.com/apppasswords), uncomment and fill in:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Ride Pulse <you@gmail.com>
DEFAULT_FROM_EMAIL=Ride Pulse <no-reply@ridepulse.local>

# Razorpay (optional): test keys from dashboard.razorpay.com (Settings > API Keys) turn on real
# checkout for wallet top-ups. The webhook secret is the one you set for
# /api/v1/payments/razorpay/webhook/ (event: payment.captured).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Monitoring (optional). SENTRY_DSN from sentry.io reports errors; METRICS_TOKEN protects the
# Prometheus endpoint at /metrics ("Authorization: Bearer <token>"); LOG_FORMAT=json for
# structured logs.
SENTRY_DSN=
METRICS_TOKEN=
LOG_FORMAT=text

# Phone login (OTP by SMS): console (codes in the log; shown in the app in DEBUG), twilio or msg91.
SMS_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Masked calling between rider and driver (Exotel click-to-call). Empty: demo mode.
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_SUBDOMAIN=api.exotel.com

# Web Push notifications: python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@ridepulse.dev
